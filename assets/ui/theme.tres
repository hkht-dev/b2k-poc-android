content_margin_bottom = 5.0
bg_color = Color(0.42, 0.31, 0.208, 1)
corner_radius_top_left = 5
corner_radius_top_right = 5
corner_radius_bottom_right = 5
corner_radius_bottom_left = 5

; The grabber: a 28 px parchment disc with an ink rim, radial so it needs no
; image file. PLACEHOLDER for the lotus mark of GDD §10 "UI art".
[sub_resource type="Gradient" id="Gradient_grabber"]
offsets = PackedFloat32Array(0, 0.64, 0.72, 0.9, 1)
colors = PackedColorArray(0.957, 0.925, 0.847, 1, 0.957, 0.925, 0.847, 1, 0.42, 0.31, 0.208, 1, 0.42, 0.31, 0.208, 1, 0.42, 0.31, 0.208, 0)

[sub_resource type="GradientTexture2D" id="GradientTexture2D_grabber"]
gradient = SubResource("Gradient_grabber")
width = 28
height = 28
fill = 1
fill_from = Vector2(0.5, 0.5)
fill_to = Vector2(1, 0.5)

[sub_resource type="Gradient" id="Gradient_grabber_hover"]
offsets = PackedFloat32Array(0, 0.64, 0.72, 0.9, 1)
colors = PackedColorArray(0.898, 0.859, 0.765, 1, 0.898, 0.859, 0.765, 1, 0.24, 0.17, 0.11, 1, 0.24, 0.17, 0.11, 1, 0.24, 0.17, 0.11, 0)

[sub_resource type="GradientTexture2D" id="GradientTexture2D_grabber_hover"]
gradient = SubResource("Gradient_grabber_hover")
width = 28
height = 28
fill = 1
fill_from = Vector2(0.5, 0.5)
fill_to = Vector2(1, 0.5)

[sub_resource type="Gradient" id="Gradient_grabber_disabled"]
offsets = PackedFloat32Array(0, 0.64, 0.72, 0.9, 1)
colors = PackedColorArray(0.957, 0.925, 0.847, 0.5, 0.957, 0.925, 0.847, 0.5, 0.42, 0.31, 0.208, 0.4, 0.42, 0.31, 0.208, 0.4, 0.42, 0.31, 0.208, 0)

[sub_resource type="GradientTexture2D" id="GradientTexture2D_grabber_disabled"]
gradient = SubResource("Gradient_grabber_disabled")
width = 28
height = 28
fill = 1
fill_from = Vector2(0.5, 0.5)
fill_to = Vector2(1, 0.5)

[resource]
default_font = ExtResource("1_body")
default_font_size = 16
Button/colors/font_color = Color(0.42, 0.31, 0.208, 1)
Button/colors/font_disabled_color = Color(0.42, 0.31, 0.208, 0.5)
Button/colors/font_focus_color = Color(0.24, 0.17, 0.11, 1)
Button/colors/font_hover_color = Color(0.32, 0.23, 0.15, 1)
Button/colors/font_hover_pressed_color = Color(0.24, 0.17, 0.11, 1)
Button/colors/font_pressed_color = Color(0.24, 0.17, 0.11, 1)
Button/font_sizes/font_size = 20
Button/styles/disabled = SubResource("StyleBoxFlat_button_disabled")
Button/styles/focus = SubResource("StyleBoxFlat_focus")
Button/styles/hover = SubResource("StyleBoxFlat_button_hover")
Button/styles/hover_pressed = SubResource("StyleBoxFlat_button_pressed")
Button/styles/normal = SubResource("StyleBoxFlat_button")
Button/styles/pressed = SubResource("StyleBoxFlat_button_pressed")
CheckButton/styles/disabled = SubResource("StyleBoxFlat_toggle")
CheckButton/styles/focus = SubResource("StyleBoxFlat_toggle_focus")
CheckButton/styles/hover = SubResource("StyleBoxFlat_toggle")
CheckButton/styles/hover_pressed = SubResource("StyleBoxFlat_toggle")
CheckButton/styles/normal = SubResource("StyleBoxFlat_toggle")
CheckButton/styles/pressed = SubResource("StyleBoxFlat_toggle")
ChoiceCard/base_type = &"PanelContainer"
ChoiceCard/styles/panel = SubResource("StyleBoxFlat_card")
HSlider/constants/center_grabber = 0
HSlider/constants/grabber_offset = 0
HSlider/icons/grabber = SubResource("GradientTexture2D_grabber")
HSlider/icons/grabber_disabled = SubResource("GradientTexture2D_grabber_disabled")
HSlider/icons/grabber_highlight = SubResource("GradientTexture2D_grabber_hover")
HSlider/styles/grabber_area = SubResource("StyleBoxFlat_slider_fill")
HSlider/styles/grabber_area_highlight = SubResource("StyleBoxFlat_slider_fill_hover")
HSlider/styles/slider = SubResource("StyleBoxFlat_slider_track")
Label/colors/font_color = Color(0.42, 0.31, 0.208, 1)
Panel/styles/panel = SubResource("StyleBoxFlat_panel")
PanelContainer/styles/panel = SubResource("StyleBoxFlat_panel")

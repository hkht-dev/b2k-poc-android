[gd_resource type="Theme" load_steps=4 format=3]

; Cream parchment panels, one serif for headings, one sans for body,
; 16 dp minimum body text (CLAUDE_CODE_BRIEF.md §6, GDD §11).

[ext_resource type="FontVariation" path="res://assets/ui/font_body.tres" id="1_body"]

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_panel"]
bg_color = Color(0.957, 0.925, 0.847, 1)
corner_radius_top_left = 8
corner_radius_top_right = 8
corner_radius_bottom_right = 8
corner_radius_bottom_left = 8

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_button"]
bg_color = Color(0.957, 0.925, 0.847, 1)
border_width_left = 2
border_width_top = 2
border_width_right = 2
border_width_bottom = 2
border_color = Color(0.42, 0.31, 0.208, 1)
corner_radius_top_left = 6
corner_radius_top_right = 6
corner_radius_bottom_right = 6
corner_radius_bottom_left = 6
content_margin_left = 28.0
content_margin_top = 16.0
content_margin_right = 28.0
content_margin_bottom = 16.0

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_button_hover"]
bg_color = Color(0.898, 0.859, 0.765, 1)
border_width_left = 2
border_width_top = 2
border_width_right = 2
border_width_bottom = 2
border_color = Color(0.42, 0.31, 0.208, 1)
corner_radius_top_left = 6
corner_radius_top_right = 6
corner_radius_bottom_right = 6
corner_radius_bottom_left = 6
content_margin_left = 28.0
content_margin_top = 16.0
content_margin_right = 28.0
content_margin_bottom = 16.0

[resource]
default_font = ExtResource("1_body")
default_font_size = 16
Button/colors/font_color = Color(0.42, 0.31, 0.208, 1)
Button/colors/font_disabled_color = Color(0.42, 0.31, 0.208, 0.5)
Button/colors/font_focus_color = Color(0.42, 0.31, 0.208, 1)
Button/colors/font_hover_color = Color(0.42, 0.31, 0.208, 1)
Button/colors/font_hover_pressed_color = Color(0.42, 0.31, 0.208, 1)
Button/colors/font_pressed_color = Color(0.42, 0.31, 0.208, 1)
Button/font_sizes/font_size = 20
Button/styles/hover = SubResource("StyleBoxFlat_button_hover")
Button/styles/normal = SubResource("StyleBoxFlat_button")
Button/styles/pressed = SubResource("StyleBoxFlat_button_hover")
ChoiceCard/base_type = &"PanelContainer"
ChoiceCard/styles/panel = SubResource("StyleBoxFlat_button")
Label/colors/font_color = Color(0.42, 0.31, 0.208, 1)
Panel/styles/panel = SubResource("StyleBoxFlat_panel")
PanelContainer/styles/panel = SubResource("StyleBoxFlat_panel")

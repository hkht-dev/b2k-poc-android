[gd_resource type="StandardMaterial3D" format=3]

; The light a window gives back that the street does not have (the Tell
; `window_glow`, GDD §6 "Tells"): warm, unlit, faint. Never blue, never
; pink: the Grove's colours stay out of Hollow Vale (GDD §10).
; PLACEHOLDER: a painted reflection of GDD §10.

[resource]
resource_name = "tell_glow"
transparency = 1
shading_mode = 0
albedo_color = Color(1, 0.85, 0.6, 0.6)

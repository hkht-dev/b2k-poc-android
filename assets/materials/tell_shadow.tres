[gd_resource type="StandardMaterial3D" format=3]

; A shadow, or a wet mark, lying on the ground where the Tells show
; (tools/street_parts/tells.py; GDD §6 "Tells"): dark, a little see-through,
; unlit so the sun neither brightens it nor throws it again.
; PLACEHOLDER: the painted decals of GDD §10.

[resource]
resource_name = "tell_shadow"
transparency = 1
shading_mode = 0
albedo_color = Color(0.12, 0.1, 0.09, 0.8)

; Journey Back to Krishna — Slice 1 ("The Street")
; Engine version is pinned: Godot 4.3 (CLAUDE_CODE_BRIEF.md §1).

config_version=5

[application]

config/name="Journey Back to Krishna"
config/description="Slice 1 — The Street. A grey-box vertical slice of Act 3 (Hollow Vale)."
config/version="0.1.0-slice1"
run/main_scene="res://scenes/core/Main.tscn"
config/features=PackedStringArray("4.3", "Mobile")
config/icon="res://assets/ui/icon.svg"

[autoload]

; Order matters: GameState reads files through Strings; Content binds to both.
Strings="*res://scripts/core/strings.gd"
GameState="*res://scripts/core/game_state.gd"
Content="*res://scripts/core/content.gd"

[debug]

gdscript/warnings/untyped_declaration=1

[display]

window/size/viewport_width=1080
window/size/viewport_height=1920
window/size/window_width_override=405
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[editor_plugins]

enabled=PackedStringArray("res://addons/gut/plugin.cfg")

[file_customization]

folder_colors={
"res://data/": "teal",
"res://docs/": "gray",
"res://scenes/": "blue",
"res://scripts/": "purple"
}

[gui]

theme/custom="res://assets/ui/theme.tres"
theme/default_font_subpixel_positioning=0

[input]

; Desktop/web fallback only (CLAUDE_CODE_BRIEF.md §4.2). Touch is the primary
; input and goes through the on-screen controls, not the input map.
move_forward={
"deadzone": 0.2,
"events": [Object(InputEventJoypadMotion,"axis":1,"axis_value":-1.0,"script":null)
, Object(InputEventKey,"keycode":87,"physical_keycode":0,"unicode":0,"location":0,"echo":false,"script":null)
, Object(InputEventKey,"keycode":4194320,"physical_keycode":0,"unicode":0,"location":0,"echo":false,"script":null)
]
}
move_back={
"deadzone": 0.2,
"events": [Object(InputEventJoypadMotion,"axis":1,"axis_value":1.0,"script":null)
, Object(InputEventKey,"keycode":83,"physical_keycode":0,"unicode":0,"location":0,"echo":false,"script":null)
, Object(InputEventKey,"keycode":4194322,"physical_keycode":0,"unicode":0,"location":0,"echo":false,"script":null)
]
}
move_left={
"deadzone": 0.2,
"events": [Object(InputEventJoypadMotion,"axis":0,"axis_value":-1.0,"script":null)
, Object(InputEventKey,"keycode":65,"physical_keycode":0,"unicode":0,"location":0,"echo":false,"script":null)
, Object(InputEventKey,"keycode":4194319,"physical_keycode":0,"unicode":0,"location":0,"echo":false,"script":null)
]
}
move_right={
"deadzone": 0.2,
"events": [Object(InputEventJoypadMotion,"axis":0,"axis_value":1.0,"script":null)
, Object(InputEventKey,"keycode":68,"physical_keycode":0,"unicode":0,"location":0,"echo":false,"script":null)
, Object(InputEventKey,"keycode":4194321,"physical_keycode":0,"unicode":0,"location":0,"echo":false,"script":null)
]
}
contextual={
"deadzone": 0.2,
"events": [Object(InputEventKey,"keycode":69,"physical_keycode":0,"unicode":0,"location":0,"echo":false,"script":null)
, Object(InputEventJoypadButton,"button_index":0,"pressure":0.0,"pressed":true,"script":null)
]
}
pause={
"deadzone": 0.2,
"events": [Object(InputEventKey,"keycode":4194305,"physical_keycode":0,"unicode":0,"location":0,"echo":false,"script":null)
, Object(InputEventJoypadButton,"button_index":6,"pressure":0.0,"pressed":true,"script":null)
]
}
look_left={
"deadzone": 0.15,
"events": [Object(InputEventJoypadMotion,"axis":2,"axis_value":-1.0,"script":null)
]
}
look_right={
"deadzone": 0.15,
"events": [Object(InputEventJoypadMotion,"axis":2,"axis_value":1.0,"script":null)
]
}
look_up={
"deadzone": 0.15,
"events": [Object(InputEventJoypadMotion,"axis":3,"axis_value":-1.0,"script":null)
]
}
look_down={
"deadzone": 0.15,
"events": [Object(InputEventJoypadMotion,"axis":3,"axis_value":1.0,"script":null)
]
}

; Godot 4.3 ships ui_accept and ui_cancel with no gamepad button at all
; (Enter/Space and Escape only), and every Button in the engine fires on
; ui_accept: without these two rows a pad could not press Begin on the title
; screen, choose a card, close a screen or leave the wardrobe. A is accept,
; as it already is for `contextual`; B is cancel. The keyboard events are
; repeated here because naming an action in this file replaces its default.
ui_accept={
"deadzone": 0.5,
"events": [Object(InputEventKey,"keycode":4194309,"physical_keycode":0,"unicode":0,"location":0,"echo":false,"script":null)
, Object(InputEventKey,"keycode":4194310,"physical_keycode":0,"unicode":0,"location":0,"echo":false,"script":null)
, Object(InputEventKey,"keycode":32,"physical_keycode":0,"unicode":0,"location":0,"echo":false,"script":null)
, Object(InputEventJoypadButton,"button_index":0,"pressure":0.0,"pressed":true,"script":null)
]
}
ui_cancel={
"deadzone": 0.5,
"events": [Object(InputEventKey,"keycode":4194305,"physical_keycode":0,"unicode":0,"location":0,"echo":false,"script":null)
, Object(InputEventJoypadButton,"button_index":1,"pressure":0.0,"pressed":true,"script":null)
]
}

[input_devices]

pointing/emulate_touch_from_mouse=true

[internationalization]

locale/translation_remaps={}

[rendering]

renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
; The Web platform only offers the Compatibility backend; name it rather than
; relying on a silent fallback. The web build is for review only
; (CLAUDE_CODE_BRIEF.md §8); touch and performance are judged on Android.
renderer/rendering_method.web="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=1
; One 2048 orthogonal shadow map: enough for a 70 m block on a 2020 phone.
lights_and_shadows/directional_shadow/size=2048
lights_and_shadows/directional_shadow/size.mobile=2048
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=1
lights_and_shadows/directional_shadow/soft_shadow_filter_quality.mobile=0
environment/defaults/default_clear_color=Color(0.76, 0.72, 0.63, 1)

[gd_scene load_steps=4 format=3]

; The painted scroll a tale is told on (scripts/ui/scroll_screen.gd). The
; paper and its rolled ends are drawn by the script; these are the words on
; it and the two buttons. Positions are set by the script from the paper's
; rectangle, so anchors here are nominal.

[ext_resource type="Script" path="res://scripts/ui/scroll_screen.gd" id="1_scroll"]
[ext_resource type="FontVariation" path="res://assets/ui/font_heading.tres" id="2_heading"]
[ext_resource type="FontVariation" path="res://assets/ui/font_body.tres" id="3_body"]

[node name="ScrollScreen" type="Control"]
process_mode = 3
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
focus_mode = 0
script = ExtResource("1_scroll")

[node name="Title" type="Label" parent="."]
unique_name_in_owner = true
layout_mode = 0
mouse_filter = 2
theme_override_colors/font_color = Color(0.3, 0.2, 0.12, 1)
theme_override_fonts/font = ExtResource("2_heading")
theme_override_font_sizes/font_size = 32
horizontal_alignment = 1
vertical_alignment = 1
autowrap_mode = 3
text_overrun_behavior = 3

[node name="Sitting" type="Label" parent="."]
unique_name_in_owner = true
layout_mode = 0
mouse_filter = 2
theme_override_colors/font_color = Color(0.42, 0.31, 0.208, 1)
theme_override_fonts/font = ExtResource("3_body")
theme_override_font_sizes/font_size = 22
horizontal_alignment = 1
vertical_alignment = 1

[node name="Panel" type="Label" parent="."]
unique_name_in_owner = true
layout_mode = 0
mouse_filter = 2
theme_override_colors/font_color = Color(0.22, 0.15, 0.09, 1)
theme_override_fonts/font = ExtResource("2_heading")
theme_override_font_sizes/font_size = 34
horizontal_alignment = 1
vertical_alignment = 1
autowrap_mode = 3

[node name="Hint" type="Label" parent="."]
unique_name_in_owner = true
layout_mode = 0
mouse_filter = 2
theme_override_colors/font_color = Color(0.42, 0.31, 0.208, 0.8)
theme_override_fonts/font = ExtResource("3_body")
theme_override_font_sizes/font_size = 22
horizontal_alignment = 1
vertical_alignment = 1

[node name="Source" type="Label" parent="."]
unique_name_in_owner = true
layout_mode = 0
mouse_filter = 2
theme_override_colors/font_color = Color(0.42, 0.31, 0.208, 0.9)
theme_override_fonts/font = ExtResource("3_body")
theme_override_font_sizes/font_size = 20
horizontal_alignment = 1
vertical_alignment = 1
autowrap_mode = 3

[node name="BackButton" type="Button" parent="."]
unique_name_in_owner = true
layout_mode = 0
focus_mode = 0
text = "Back"

[node name="CloseButton" type="Button" parent="."]
unique_name_in_owner = true

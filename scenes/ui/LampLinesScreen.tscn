[gd_scene load_steps=3 format=3]

; The twelve lines a lamp can carry (scripts/ui/lamp_lines_screen.gd). The
; buttons are built from data/lamp_lines.json at ready; the texts here are
; overwritten from the string table.

[ext_resource type="Script" path="res://scripts/ui/lamp_lines_screen.gd" id="1_lamp_lines"]
[ext_resource type="FontVariation" path="res://assets/ui/font_heading.tres" id="2_heading"]

[node name="LampLinesScreen" type="Control"]
process_mode = 3
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_lamp_lines")

[node name="Dim" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.1, 0.08, 0.05, 0.6)

[node name="Panel" type="PanelContainer" parent="."]
layout_mode = 1
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -420.0
offset_top = -700.0
offset_right = 420.0
offset_bottom = 700.0
grow_horizontal = 2
grow_vertical = 2

[node name="Margin" type="MarginContainer" parent="Panel"]
layout_mode = 2
theme_override_constants/margin_left = 40
theme_override_constants/margin_top = 40
theme_override_constants/margin_right = 40
theme_override_constants/margin_bottom = 40

[node name="Layout" type="VBoxContainer" parent="Panel/Margin"]
layout_mode = 2
theme_override_constants/separation = 24

[node name="Title" type="Label" parent="Panel/Margin/Layout"]
unique_name_in_owner = true
layout_mode = 2
theme_override_fonts/font = ExtResource("2_heading")
theme_override_font_sizes/font_size = 40
text = "What should the lamp say?"
horizontal_alignment = 1
autowrap_mode = 3

[node name="Lines" type="VBoxContainer" parent="Panel/Margin/Layout"]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/separation = 10

[node name="CancelButton" type="Button" parent="Panel/Margin/Layout"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 88)
layout_mode = 2
text = "Not now"

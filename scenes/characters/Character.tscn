[gd_scene load_steps=5 format=3]

; A rigged human for the Street: Kenney's "Animated Characters Retro" body
; with Quaternius' Universal Animation Library clips (both CC0, docs/
; RIGHTS_REGISTER.md), joined through Godot's humanoid profile and assembled
; by scripts/characters/character_rig.gd. Instance it and set `skin`.
;
; PLACEHOLDER: the body. Replaced by the traveler form of GDD §10 "Characters"
; (elongated proportions, hand-painted cloth); the clips can stay.

[ext_resource type="Script" path="res://scripts/characters/character_rig.gd" id="1_rig"]
[ext_resource type="PackedScene" path="res://assets/thirdparty/kenney/animated-characters-retro/characterMedium.fbx" id="2_body"]
[ext_resource type="Texture2D" path="res://assets/thirdparty/kenney/animated-characters-retro/humanMaleA.png" id="3_skin"]
[ext_resource type="PackedScene" path="res://assets/thirdparty/quaternius/universal-animation-library/UAL1_Standard.glb" id="4_clips"]

[node name="Character" type="Node3D"]
script = ExtResource("1_rig")
body = ExtResource("2_body")
skin = ExtResource("3_skin")
height = 1.75
body_height = 3.7
idle_scene = ExtResource("4_clips")
idle_animation = "Idle"
walk_scene = ExtResource("4_clips")
walk_animation = "Walk"
walk_reference_speed = 1.5
run_scene = ExtResource("4_clips")
run_animation = "Jog_Fwd"
run_reference_speed = 3.6
run_above = 3.2

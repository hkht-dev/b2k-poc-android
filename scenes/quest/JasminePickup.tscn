[gd_scene load_steps=4 format=3]

; A jasmine flower lying where a Glimpse was (GDD §6; scripts/quest/
; pickup_item.gd). *Pick up* puts it in the hand and nothing happens. The
; Glimpse that leaves it gives it its own event id, so two points that leave
; jasmine do not share one.

[ext_resource type="Script" path="res://scripts/quest/pickup_item.gd" id="1_pickup"]
[ext_resource type="Script" path="res://scripts/lib/interactable.gd" id="2_interact"]
[ext_resource type="PackedScene" path="res://scenes/quest/Jasmine.tscn" id="3_jasmine"]

[sub_resource type="CylinderShape3D" id="CylinderShape3D_near"]
radius = 1.6
height = 2.4

[node name="JasminePickup" type="Node3D"]
script = ExtResource("1_pickup")
item = "jasmine"
event = "jasmine_picked_up"

[node name="PickUp" type="Area3D" parent="."]
unique_name_in_owner = true
script = ExtResource("2_interact")
verb_id = "verb.pick_up"

[node name="Shape" type="CollisionShape3D" parent="PickUp"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 1.0, 0)
shape = SubResource("CylinderShape3D_near")

[node name="Jasmine" parent="." instance=ExtResource("3_jasmine")]
transform = Transform3D(0.82, 0, -0.57, 0, 1, 0, 0.57, 0, 0.82, 0, 0.02, 0)

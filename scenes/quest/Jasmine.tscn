[gd_scene load_steps=6 format=3]

; A single jasmine flower: six white petals round a pale centre on a short
; green stem, from primitives. In a hand (carried) or on the ground (what a
; Glimpse leaves when it is not a feather, GDD §6). White and a muted green:
; nothing here is peacock blue or magenta.
; PLACEHOLDER: replaced by the painted jasmine of GDD §10 (the Grove's
; "jasmine white"; Krishna's garland).

[sub_resource type="StandardMaterial3D" id="Mat_petal"]
resource_name = "jasmine_petal"
albedo_color = Color(0.97, 0.96, 0.9, 1)
roughness = 0.7

[sub_resource type="StandardMaterial3D" id="Mat_centre"]
resource_name = "jasmine_centre"
albedo_color = Color(0.93, 0.85, 0.55, 1)
roughness = 0.8

[sub_resource type="StandardMaterial3D" id="Mat_stem"]
resource_name = "jasmine_stem"
albedo_color = Color(0.32, 0.45, 0.26, 1)
roughness = 0.9

[sub_resource type="SphereMesh" id="SphereMesh_petal"]
radius = 0.5
height = 1.0
radial_segments = 8
rings = 4

[sub_resource type="CylinderMesh" id="CylinderMesh_stem"]
top_radius = 0.005

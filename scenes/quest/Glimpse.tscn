[gd_scene load_steps=6 format=3]

; A Glimpse point (scripts/quest/glimpse.gd). The figure is the shared rigged
; body painted as a silhouette, a flute in hand, a feather in the hair, a
; warm rim light behind it that nothing else in the scene has. Which pose it
; holds, what it leaves (one of the two pick-ups below; the script frees the
; other on load) and where that lies are exports on each instance:
; tools/gen_street.py places the traffic light's, tools/street_parts/
; glimpses.py the other four points of GDD §6.
; PLACEHOLDER: the extruded silhouette with feather and cloth outline of
; GDD §10 replaces the body.

[ext_resource type="Script" path="res://scripts/quest/glimpse.gd" id="1_glimpse"]
[ext_resource type="PackedScene" path="res://scenes/characters/Character.tscn" id="2_character"]
[ext_resource type="PackedScene" path="res://scenes/quest/FeatherPickup.tscn" id="3_feather"]
[ext_resource type="PackedScene" path="res://scenes/quest/Feather.tscn" id="4_crest"]
[ext_resource type="PackedScene" path="res://scenes/quest/JasminePickup.tscn" id="5_jasmine"]

[node name="Glimpse" type="Node3D"]
script = ExtResource("1_glimpse")

[node name="Figure" parent="." instance=ExtResource("2_character")]
unique_name_in_owner = true
height = 1.7
idle_animation = "Sitting_Idle"
walk_animation = "Sitting_Idle"
run_animation = "Sitting_Idle"

; The feather in the hair: peacock blue, the Street's one exception.
[node name="Crest" parent="Figure" instance=ExtResource("4_crest")]
transform = Transform3D(0.6, 0, 0, 0, 0.2, 0.57, 0, -0.57, 0.2, 0.06, 1.62, -0.02)

[node name="RimLight" type="OmniLight3D" parent="."]
unique_name_in_owner = true
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0.2, 1.4, -1.2)
light_color = Color(1, 0.72, 0.42, 1)
light_energy = 3.5
omni_range = 5.0
shadow_enabled = false

; Both pick-ups sit at the origin here; the script moves the one this point
; leaves to `leaves_offset` and frees the other.
[node name="FeatherPickup" parent="." instance=ExtResource("3_feather")]
unique_name_in_owner = true

[node name="JasminePickup" parent="." instance=ExtResource("5_jasmine")]
unique_name_in_owner = true

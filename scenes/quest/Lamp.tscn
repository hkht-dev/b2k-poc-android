[gd_scene load_steps=8 format=3]

; A lamp someone set down (scripts/quest/lamp.gd): a low clay dish, a warm
; flame, a small light that carries three metres, and *Sit* beside it. The
; Place base spawns one for every lamp record of its place (GDD §16a
; "Social: lamps"). Warm orange only: peacock blue and magenta are forbidden
; in the Street (GDD §10).
; PLACEHOLDER: the hand-painted clay diya of GDD §10 replaces the primitives.

[ext_resource type="Script" path="res://scripts/quest/lamp.gd" id="1_lamp"]
[ext_resource type="Script" path="res://scripts/lib/interactable.gd" id="2_interact"]


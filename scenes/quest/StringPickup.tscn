[gd_scene load_steps=5 format=3]

; The missing string where it lies, on a shelf in Nanda's flat
; (scripts/quest/pickup_item.gd). Pick up puts it in the hand, sets
; has_sarang_string and fires sarang_string_picked_up so a loaded journey does
; not lay it down again. The giving happens at Sarang's corner, not here.

[ext_resource type="Script" path="res://scripts/quest/pickup_item.gd" id="1_pickup"]
[ext_resource type="Script" path="res://scripts/lib/interactable.gd" id="2_interact"]
[ext_resource type="PackedScene" path="res://scenes/quest/InstrumentString.tscn" id="3_string"]

[sub_resource type="CylinderShape3D" id="CylinderShape3D_near"]
radius = 1.4
height = 2.4

[node name="StringPickup" type="Node3D"]
script = ExtResource("1_pickup")
item = "string"
event = "sarang_string_picked_up"
flag = "has_sarang_string"

[node name="PickUp" type="Area3D" parent="."]
unique_name_in_owner = true
script = ExtResource("2_interact")
verb_id = "verb.pick_up"

[node name="Shape" type="CollisionShape3D" parent="PickUp"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, -0.3, 0)
shape = SubResource("CylinderShape3D_near")

[node name="String" parent="." instance=ExtResource("3_string")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0, -0.12)

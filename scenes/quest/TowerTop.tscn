[gd_scene load_steps=9 format=3]

; The top of the billboard tower (scripts/quest/tower_top.gd): the roof as a
; place the journey notices once, and the Veena on its stand at the centre,
; where the dawn choice is made (GDD §5 "Rooftop", §8 Scene E). Placed on
; the roof lid by tools/street_parts/tower_climb.py. Every flag and line id
; is data on the root node.
; PLACEHOLDER: a timber post for the stand and scenes/quest/Veena.tscn on
; it; both replaced by the custom Veena of GDD §10.

[ext_resource type="Script" path="res://scripts/quest/tower_top.gd" id="1_top"]
[ext_resource type="Script" path="res://scripts/lib/interactable.gd" id="2_interact"]
[ext_resource type="PackedScene" path="res://scenes/quest/Veena.tscn" id="3_veena"]
[ext_resource type="Material" path="res://assets/materials/timber.tres" id="4_timber"]

[sub_resource type="BoxShape3D" id="BoxShape3D_roof"]
size = Vector3(15, 3, 15)

[sub_resource type="CylinderShape3D" id="CylinderShape3D_near"]
radius = 1.8
height = 2.4

[sub_resource type="BoxMesh" id="BoxMesh_post"]
size = Vector3(0.3, 0.95, 0.3)

[sub_resource type="BoxShape3D" id="BoxShape3D_post"]
size = Vector3(0.45, 1.0, 0.45)

[node name="TowerTop" type="Node3D"]
script = ExtResource("1_top")
arrive_flag = "on_the_tower"
line_id = "veena_dawn"
journey_lines = {
"kept_veena": "journey.dawn.kept",
"played_for_others": "journey.dawn.played"
}
chosen_flags = PackedStringArray("played_for_others", "kept_veena")
take_flag = "kept_veena"
take_item = "veena"

; The roof lid, to the block's edge: stepping onto it is arriving.
[node name="Arrive" type="Area3D" parent="."]
unique_name_in_owner = true
collision_layer = 0
collision_mask = 2
monitorable = false

[node name="Shape" type="CollisionShape3D" parent="Arrive"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 1.5, 0)
shape = SubResource("BoxShape3D_roof")

[node name="Stand" type="Node3D" parent="."]

[node name="Look" type="Area3D" parent="Stand"]
unique_name_in_owner = true
script = ExtResource("2_interact")
verb_id = "verb.look"

[node name="Shape" type="CollisionShape3D" parent="Stand/Look"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 1.0, 0)
shape = SubResource("CylinderShape3D_near")

[node name="Post" type="MeshInstance3D" parent="Stand"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0.475, 0)
mesh = SubResource("BoxMesh_post")
surface_material_override/0 = ExtResource("4_timber")

[node name="Body" type="StaticBody3D" parent="Stand"]
collision_layer = 1
collision_mask = 0

[node name="Shape" type="CollisionShape3D" parent="Stand/Body"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0.5, 0)
shape = SubResource("BoxShape3D_post")

; Lying across the stand: the Veena's long axis (local Y) along X, its
; strings (local +Z) upward. The basis is written row by row.
[node name="VeenaOnStand" parent="Stand" instance=ExtResource("3_veena")]
unique_name_in_owner = true
transform = Transform3D(0, 1, 0, 0, 0, 1, 1, 0, 0, -0.05, 1.0, 0)

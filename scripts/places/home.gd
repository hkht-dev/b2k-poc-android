## Home: the riverbank at the end of the journey, and the embrace.
##
## GDD §3 Act 5 "Home", §3a Act 5 ("Wade to the bank; one tap: the garland.
## Krishna bows; you garland Him; He embraces you"), §8 Scene F "The embrace".
## A small clearing in rose-gold light, the river at one side, stars above
## (scenes/places/Home.tscn, generated by tools/gen_home.py). The player
## wades toward a far figure; near Him the one contextual button says
## *Garland*, offered only with `garland_made` (the Interactable's
## `requires`, data on the scene). One tap: He bows, the garland leaves the
## hand for His neck, He steps the last metre, and the view goes to white.
## Then `embraced` is set, *Your journey* gets its last line and
## `slice_ended` tells Main the chapter is over. No dialogue, and no humour
## (GDD §8 "Writing rules").
extends Place

## The chapter is over: the view is white; Main shows the end screen.
signal slice_ended(reason: String)
signal embraced

const GARLAND := preload("res://scenes/quest/Garland.tscn")
const BOW_SECONDS := 1.0
## He lowers His head (§8 Scene F): the head node tilts toward the player.
const BOW_RADIANS := -0.6
const PLACE_SECONDS := 0.6
const LOOK_UP_SECONDS := 0.5
const STEP_SECONDS := 1.4
const STEP_METRES := 1.0
## §8 Scene F: the view goes to white, not black.
const FADE_SECONDS := 3.0
const WHITE := Color(1, 1, 1, 0)

## What Main is told when it is over (the bus stop says "arrived" or "sat").
@export var end_reason := "home"
@export var embraced_flag := "embraced"
@export var journey_line_id := "journey.act5.home"
## Flags another chapter will set; until it exists, arriving here sets them.
## PLACEHOLDER: `garland_made` is the Grove's (GDD §3 Act 1, beat 2).
@export var stand_in_flags: PackedStringArray = PackedStringArray()

var _ending := false

@onready var _offer: Interactable = %Offer
@onready var _figure: Node3D = %Figure
@onready var _head: Node3D = %Head
@onready var _garland: Node3D = %Garland


func _ready() -> void:
	super()
	for flag in stand_in_flags:
		GameState.set_flag(flag)
	_garland.visible = false
	_offer.used.connect(_on_offer)
	if _offer.is_available():
		_garland_in_hand()


func is_ending() -> bool:
	return _ending


func figure() -> Node3D:
	return _figure


func head() -> Node3D:
	return _head


func garland() -> Node3D:
	return _garland


func fade_colour() -> Color:
	return _fade.color


## The garland from the Grove is in the hands (GDD §3 Act 5 "Rising").
## Whatever the Street left in them is set down for it; no flag is touched.
func _garland_in_hand() -> void:
	var rig: CharacterRig = _player.get_node("%Mesh")
	if rig.is_carrying():
		rig.carry(false)
	rig.carry(true, GARLAND)


## One tap (§8 Scene F): He bows, the garland goes round His neck, He looks
## up and steps the last metre, and the view goes to white.
func _on_offer(_player_node: Node3D) -> void:
	if _ending or _leaving:
		return
	_ending = true
	_input_locked = true
	_offer.enabled = false
	_player.set_move_input(Vector2.ZERO, 0.0)
	var to := _figure.global_position - _player.global_position
	to.y = 0.0
	if to.length() > 0.01:
		_player.rotation.y = atan2(-to.x, -to.z)
		_figure.rotation.y = atan2(to.x, to.z)
	_camera_rig.drift_toward(_figure.global_position, BOW_SECONDS + PLACE_SECONDS)
	var step := -to.normalized() * STEP_METRES
	var tween := create_tween()
	tween.tween_property(_head, "rotation:x", BOW_RADIANS, BOW_SECONDS).set_trans(Tween.TRANS_SINE)
	tween.tween_callback(_place_garland)
	tween.tween_interval(PLACE_SECONDS)
	tween.tween_property(_head, "rotation:x", 0.0, LOOK_UP_SECONDS).set_trans(Tween.TRANS_SINE)
	tween.parallel().tween_property(_figure, "position", _figure.position + step, STEP_SECONDS)
	tween.tween_callback(func() -> void: _fade.color = WHITE)
	tween.tween_property(_fade, "color:a", 1.0, FADE_SECONDS)
	tween.tween_callback(_finish)


func _place_garland() -> void:
	var rig: CharacterRig = _player.get_node("%Mesh")
	rig.carry(false)
	_garland.visible = true


func _finish() -> void:
	GameState.set_flag(embraced_flag)
	GameState.add_journey_line(journey_line_id)
	embraced.emit()
	slice_ended.emit(end_reason)

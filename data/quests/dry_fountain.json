{
  "id": "dry_fountain",
  "giver": "fountain",
  "start_condition": "true",
  "steps": [
    {
      "id": "notice",
      "objective_text_id": "quest.dry_fountain.notice",
      "complete_when": "flag:looked_dry_fountain",
      "flags_set": []
    },
    {
      "id": "hear_him_out",
      "objective_text_id": "quest.dry_fountain.hear",
      "complete_when": "flag:gopal_admitted_fear",
      "flags_set": []
    },
    {
      "id": "carry",
      "objective_text_id": "quest.dry_fountain.carry",
      "complete_when": "event:can_placed_at_fountain",
      "flags_set": ["gave_dry_fountain"]
    }
  ],
  "branches": [
    {
      "id": "take",
      "when": "event:can_taken_from_shop and not flag:gopal_will_carry",
      "flags_set": ["took_dry_fountain"],
      "journey_line_id": "journey.dry_fountain.took"
    },
    {
      "id": "give",
      "when": "flag:gave_dry_fountain",
      "flags_set": [],
      "journey_line_id": "journey.dry_fountain.gave"
    }
  ],
  "end_condition": "flag:gave_dry_fountain or flag:took_dry_fountain",
  "flags_set_on_end": [],
  "journey_line_id": ""
}

        "garden_open",
        "fruit_received"
      ],
      "journey_line_id": "journey.the_fence.open"
    }
  ],
  "end_condition": "flag:garden_open or flag:has_fruit",
  "flags_set_on_end": [],
  "journey_line_id": ""
